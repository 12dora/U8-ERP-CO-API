# u8co-api 环境变量示例。复制为 .env 后按实际环境填写。不要把 .env 提交到仓库。

# ---- CO 桥（必填）----
# 桥的地址，路径必须是 /u8co。
U8CO_BRIDGE_URL=http://bridge.example.com:18089/u8co
# 共享密钥文件：一行 64 位小写十六进制，与桥的配置相同。
U8CO_BRIDGE_SECRET_FILE=/run/secrets/u8co_bridge_secret
# 读取桥响应的超时秒数，不小于 80。
U8CO_BRIDGE_TIMEOUT=90
# 存货核算记账、期末处理和经过存货核算的月末结账读桥的超时（秒），不小于上一项
U8CO_BRIDGE_LONG_TIMEOUT=1000
# 停机时等在途请求的秒数（缺省 100）。要等长时操作走完就不小于上一项，compose 的 stop_grace_period 一起调。
# U8CO_SHUTDOWN_GRACE=100

# ---- 账套白名单（缺省为空：全部 403）----
# 逗号分隔的三位账套号，例如 801,802。
U8CO_ACCOUNTS=
# 只开放读取的账套，写法同上，每个都必须在 U8CO_ACCOUNTS 中。
# U8CO_READONLY_ACCOUNTS=

# ---- 开关 ----
# 设为 0 时 /v1/co/* 全部返回 404。
U8CO_ENABLED=1

# ---- 频率和并发 ----
U8CO_RPM=30
U8CO_CONCURRENCY=8
U8CO_CALLER_CONCURRENCY=4

# ---- 认证（二选一或同时使用）----
# 1) 信任文件：JSON 数组，每项一个发行者/调用方。
U8CO_TRUST_FILE=/config/u8co-trust.json
# 2) 单个 OIDC 发行者。留空 U8CO_OIDC_ISSUER 表示不用这一项。
U8CO_OIDC_ISSUER=
U8CO_OIDC_AUDIENCE=
# 留空时按 {issuer}/.well-known/openid-configuration 取 jwks_uri。
U8CO_OIDC_JWKS_URL=
U8CO_OIDC_NAME=default
U8CO_OIDC_ALGORITHMS=RS256
U8CO_OIDC_WRITE_CLAIM=u8co_write
U8CO_OIDC_READ_CLAIM=u8co_read
U8CO_OIDC_WRITE_SCOPE=
U8CO_OIDC_READ_SCOPE=
U8CO_OIDC_ACCOUNTS_CLAIM=
# 经营管理查询（/v1/co/mgmt/*）的布尔声明名或 scope；都不设时这一发行者没有经营管理权限。
# U8CO_OIDC_MGMT_CLAIM=
# U8CO_OIDC_MGMT_SCOPE=
# 设为 1 才允许 jwks 地址用 http（本机回环地址不必设）。只在可信网络中使用。
# U8CO_OIDC_ALLOW_INSECURE_HTTP=0
U8CO_JWT_LEEWAY=60

# ---- 可选文件（不设时不启用；设了而文件有问题时进程启动失败，写入策略文件除外）----
# 按账套分流的桥（docs/configuration.md「按账套分流的桥」）。
# U8CO_BRIDGE_ROUTES_FILE=/config/u8co-routes.json
# 写入策略，与桥的 writePolicyFile 同一份 JSON（docs/configuration.md「写入策略」）。
# U8CO_WRITE_POLICY_FILE=/config/u8co-write-policy.json
# 公司间对照（docs/configuration.md「公司间对照」）。
# U8CO_IC_MAP_FILE=/config/u8co-ic-map.json
# 经营管理利润表行定义（docs/configuration.md「利润表行定义」）。
# U8CO_MGMT_LINES_FILE=/config/u8co-mgmt-lines.json

# ---- 其它 ----
# 登录日期的时区，固定偏移。
U8CO_TIMEZONE=+08:00
# 调用方传终端用户 UUID 的请求头，只写进审计。
U8CO_USER_HEADER=X-U8co-User
# 审计去向：stdout、stderr、off 或绝对路径。
U8CO_AUDIT_LOG=stdout
U8CO_API_HOST=0.0.0.0
U8CO_API_PORT=8080
